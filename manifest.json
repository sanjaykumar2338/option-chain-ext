{
  "manifest_version": 3,
  "name": "Upstox Option Chain Signal Engine",
  "version": "1.0.0",
  "description": "Scrapes Upstox Pro option-chain data and overlays a quantitative call/put signal.",
  "permissions": ["notifications", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upstox Option Signals",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://pro.upstox.com/option-chain/*"],
      "js": ["networkInterceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pro.upstox.com/option-chain/*"],
      "js": ["OptionSignalEngine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
